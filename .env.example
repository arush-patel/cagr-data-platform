# Copy to .env (never committed). Every setting has the CAGR_ prefix; see src/cagr_data/settings.py.
CAGR_DATABASE_URL=postgresql://cagr:cagr@localhost:54329/cagr_dev
CAGR_ENV=dev
CAGR_RAW_FILE_ROOT=data/raw
CAGR_LAKE_ROOT=data/lake

# Used by the tests only.
CAGR_TEST_DATABASE_URL=postgresql://cagr:cagr@localhost:54329/cagr_test

# docker compose: host port and image (set a mirror if Docker Hub rate-limits you).
CAGR_DB_PORT=54329
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:17
